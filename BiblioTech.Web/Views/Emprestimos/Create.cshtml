@{
    ViewData["Title"] = "Registrar Empréstimo";
    var livros = ViewBag.Livros as List<Livro> ?? new List<Livro>();
}
<h2>Registrar Novo Empréstimo</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Selecione o Livro Disponível</label>
        <select name="livroId" required>
            @foreach (var livro in livros)
            {
                <option value="@livro.Id">@livro.Titulo (@livro.QuantidadeDisponivel disponíveis)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label>Matrícula Institucional do Aluno</label>
        <input type="text" name="matriculaAluno" placeholder="Ex.: 2026-0412" required />
    </div>
    <div class="form-group">
        <label>Nome do Aluno</label>
        <input type="text" name="nomeAluno" required />
    </div>
    <button type="submit" class="btn">Confirmar Empréstimo</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
