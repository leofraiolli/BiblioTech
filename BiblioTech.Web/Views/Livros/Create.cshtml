@model Livro
@{
    ViewData["Title"] = "Cadastrar Livro";
    var autores = ViewBag.Autores as List<Autor> ?? new List<Autor>();
}
<h2>Cadastrar Novo Livro</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Título da Obra</label>
        <input type="text" asp-for="Titulo" required />
    </div>
    <div class="form-group">
        <label>Código ISBN</label>
        <input type="text" asp-for="Isbn" required />
    </div>
    <div class="form-group">
        <label>Ano de Publicação</label>
        <input type="number" asp-for="AnoPublicacao" required />
    </div>
    <div class="form-group">
        <label>Quantidade de Exemplares Disponíveis</label>
        <input type="number" asp-for="QuantidadeDisponivel" min="0" required />
    </div>
    <div class="form-group">
        <label>Autores da Obra (Selecione um ou mais — Relação N:N)</label>
        @foreach (var autor in autores)
        {
            <div>
                <input type="checkbox" name="autoresIds" value="@autor.Id" id="autor_@autor.Id" />
                <label for="autor_@autor.Id" style="display:inline; font-weight:normal;">@autor.Nome (@autor.Nacionalidade)</label>
            </div>
        }
    </div>
    <button type="submit" class="btn">Salvar Livro</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
