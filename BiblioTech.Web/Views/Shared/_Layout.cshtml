<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiblioTech Escolar</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; background: #f8fafc; color: #0f172a; }
        header { background: #14532d; color: #fff; padding: 14px 28px; display: flex; justify-content: space-between; align-items: center; }
        header a { color: #fff; text-decoration: none; margin-left: 18px; font-weight: 600; }
        main { max-width: 980px; margin: 28px auto; background: #fff; padding: 24px; border: 1px solid #cbd5e1; border-radius: 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 14px; }
        th, td { border: 1px solid #cbd5e1; padding: 9px 10px; text-align: left; }
        th { background: #14532d; color: #fff; }
        .btn { display: inline-block; padding: 7px 14px; background: #14532d; color: #fff; text-decoration: none; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; }
        .btn-danger { background: #991b1b; }
        .btn-secondary { background: #334155; }
        .alert-ok { background: #dcfce7; border: 1px solid #16a34a; color: #14532d; padding: 10px; margin-bottom: 14px; border-radius: 4px; }
        .alert-err { background: #fee2e2; border: 1px solid #dc2626; color: #991b1b; padding: 10px; margin-bottom: 14px; border-radius: 4px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; }
        input[type="text"], input[type="number"], select { width: 100%; padding: 8px; border: 1px solid #94a3b8; border-radius: 4px; box-sizing: border-box; }
    </style>
</head>
<body>
    <header>
        <div><strong>BiblioTech</strong> — Biblioteca Escolar (MVC + SOLID)</div>
        <nav>
            <a asp-controller="Home" asp-action="Index">Início</a>
            <a asp-controller="Livros" asp-action="Index">Livros (N:N)</a>
            <a asp-controller="Autores" asp-action="Index">Autores</a>
            <a asp-controller="Emprestimos" asp-action="Index">Empréstimos</a>
        </nav>
    </header>
    <main>
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert-ok">@TempData["Sucesso"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="alert-err">@TempData["Erro"]</div>
        }
        @if (ViewBag.Erro != null)
        {
            <div class="alert-err">@ViewBag.Erro</div>
        }
        @RenderBody()
    </main>
</body>
</html>
